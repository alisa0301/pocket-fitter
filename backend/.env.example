APP_NAME=Pocket Fitter API
CORS_ORIGINS=["http://localhost:5173"]

# Get a key at https://aistudio.google.com/apikey . Without it the API uses a scripted demo flow.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# Final club decision engine: auto | gemini | rules | jeff
DECISION_ENGINE=auto
JEFF_URL=

# MongoDB Atlas (optional): catalog, saved fittings, "golfers like you" vector search
MONGODB_URI=
MONGODB_DB=pocket_fitter
